# Sao chép thành deploy/.env trên VPS (chmod 600). Không commit.
POSTGRES_DB=quan_ly_tam_ung
POSTGRES_USER=app_web
POSTGRES_PASSWORD=doi-mat-khau-manh
TZ=Asia/Ho_Chi_Minh

ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-admin
ADMIN_NAME=Quản trị viên
ADMIN_EMAIL=

# Copy từ /opt/qlcv/deploy/.env — KHÔNG sửa file kia, KHÔNG đổi JWT trên Document Server.
ONLYOFFICE_JWT_SECRET=

# Nhập hóa đơn qua Telegram + Windows Service scan.
TELEGRAM_BOT_TOKEN=
# Bắt buộc để Telegram xác thực webhook. Tạo bằng:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://hc.ttdt.site/api/telegram/webhook
INTAKE_PUBLIC_URL=https://hc.ttdt.site
# Bắt buộc để mã hóa token bot lưu trong bảng cau_hinh. Không đổi sau khi đã lưu token.
INTAKE_TOKEN_ENCRYPTION_KEY=
# Sao lưu vào Drive cá nhân: đặt JSON OAuth web client trong BACKUP_CONFIG_DIR.
# Tạo khóa bằng: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
GOOGLE_DRIVE_TOKEN_KEY=
BACKUP_CONFIG_DIR=/etc/quan-ly-tam-ung
BACKUP_KEEP_DAYS=14
