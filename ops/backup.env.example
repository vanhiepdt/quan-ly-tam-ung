APP_DIR=/opt/quan-ly-tam-ung
BACKUP_DIR=/var/backups/quan-ly-tam-ung
DB_CONTAINER=quan-ly-tam-ung-db
APP_CONTAINER=quan-ly-tam-ung-app
BACKUP_TZ=Asia/Bangkok
KEEP_LOCAL_DAYS=14
# Chia se thu muc Google Drive cho email client_email trong JSON Service Account.
GOOGLE_DRIVE_FOLDER_ID=PASTE_GOOGLE_DRIVE_FOLDER_ID_HERE
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=/etc/quan-ly-tam-ung/google-drive-service-account.json