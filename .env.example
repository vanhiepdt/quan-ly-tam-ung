DATABASE_URL=postgresql://app_web:MAT_KHAU_MANH@127.0.0.1:5432/quan_ly_tam_ung
UPLOAD_DIR=/var/lib/tam-ung/tep
# Đăng nhập bằng TÊN ĐĂNG NHẬP (không phải email), 3-50 ký tự: chữ không dấu, số, dấu . _ -
ADMIN_USERNAME=admin
ADMIN_PASSWORD=DOI_MAT_KHAU_NGAY
ADMIN_NAME=Quản trị viên
# Không bắt buộc, chỉ để lưu thông tin liên hệ
ADMIN_EMAIL=admin@example.com
# Lớp 2 đọc hóa đơn: khóa dự phòng theo nhà cung cấp đã chọn trong Cài đặt AI.
# Ưu tiên khóa lưu trong Cài đặt; nếu trống thì dùng biến tương ứng dưới đây.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
AI_API_KEY=
# Postgres trong Docker nội bộ: tắt TLS. Production có chứng chỉ thì để trống hoặc true.
DATABASE_SSL=false
# Giấy Word trên VPS: dùng Document Server sẵn có (office.ttdt.site), không dựng thêm container.
# Khóa JWT phải trùng khóa của Document Server đang chạy; không đổi khóa bên kia.
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_PUBLIC_URL=https://office.ttdt.site
ONLYOFFICE_INTERNAL_URL=http://onlyoffice
ONLYOFFICE_APP_URL=http://quan-ly-tam-ung-app:3000
# Nhập hóa đơn qua Telegram + Windows Service scan.
# Có thể nhập token bot trong Cài đặt; biến này là fallback tùy chọn.
TELEGRAM_BOT_TOKEN=
# Bắt buộc khi bấm Đặt webhook Telegram. Tạo bằng:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://hc.ttdt.site/api/telegram/webhook
INTAKE_PUBLIC_URL=https://hc.ttdt.site
# Bắt buộc khi lưu token bot trong Cài đặt. Tạo bằng cùng lệnh randomBytes ở trên,
# giữ nguyên giá trị này sau khi đã lưu token bot.
INTAKE_TOKEN_ENCRYPTION_KEY=
